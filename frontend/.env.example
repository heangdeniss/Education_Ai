# Your Hugging Face Space id ("username/space-name") or a full URL
# (e.g. http://127.0.0.1:7860 when running space/app.py locally).
VITE_HF_SPACE=your-username/your-space-name

# Optional: only needed if the Space is private, or to use your own ZeroGPU quota.
# WARNING: anything prefixed with VITE_ is bundled into the public JS. Do not
# set this for a publicly deployed site.
VITE_HF_TOKEN=
